# Telegram Configuration
TELEGRAM_BOT_TOKEN=XXXXXXXXXX:YYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYY

# Postgres Connection Variables
DB_HOST=localhost
DB_PORT=5432
DB_USER=db-user
DB_PASSWORD=secret-password
DB_NAME=bot-db

# Can be created with Docker
#   docker run -d \
#      --name TGBot-PostgreSQL \
#      -e POSTGRES_USER=db-user \
#      -e POSTGRES_PASSWORD=secret-password \
#      -e POSTGRES_DB=bot-db \
#      -p 5432:5432 \
#      -v tgbot_pgdata:/Users/{username}/TGBotSwiftTemplate/PostgreSQL \
#      postgres:16-alpine

# Access. Unset (the default): invite-only — /link mints a five-minute invite.
# 1 / true / yes / on: the open door — anyone who writes to the bot is added to
# allowed_users and goes straight to registration. Read at boot; a restart
# applies a change, and closing the door again keeps everyone already inside.
# ROI_OPEN_ACCESS=1
